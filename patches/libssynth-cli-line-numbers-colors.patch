@@ -1,6 +1,8 @@
 #pragma once
 #include <QString>
 
+#include <exception>
+
 namespace ssynth
 {
 namespace Exceptions
@@ -12,8 +14,9 @@ namespace Exceptions
 ///  (1) Throw temporaries   (throw Exception("Error occoured");)
 ///  (2) Catch by reference  ( try {} catch (Exception& e) {} )
 ///
-/// (Perhaps this ought to inherit from std::exception?)
-class Exception
+/// Inherits std::exception so `catch (std::exception&)` in callers
+/// actually catches it (previously it did not, causing std::terminate).
+class Exception : public std::exception
 {
 
 public:
@@ -24,8 +27,15 @@ public:
   /// Returns the error message.
   QString getMessage() const { return message; }
 
+  const char* what() const noexcept override
+  {
+    whatBuf = message.toUtf8();
+    return whatBuf.constData();
+  }
+
 private:
   QString message;
+  mutable QByteArray whatBuf;
 };
 
 }
