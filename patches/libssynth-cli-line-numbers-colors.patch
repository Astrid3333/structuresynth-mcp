diff --git a/src/CommandLine.cpp b/src/CommandLine.cpp
index 7c616a2..cacbd7e 100644
--- a/src/CommandLine.cpp
+++ b/src/CommandLine.cpp
@@ -64,12 +64,13 @@ rule R1 w 10 {
   }
 
   // QLogger l;
+  QString preprocessed;
   try
   {
     ssynth::Parser::Preprocessor p;
-    auto preprocessed = p.Process(input);
+    preprocessed = p.Process(input);
 
-    ssynth::Parser::Tokenizer t{std::move(preprocessed)};
+    ssynth::Parser::Tokenizer t{preprocessed};
     ssynth::Parser::EisenParser e{t};
 
     auto ruleset = std::unique_ptr<ssynth::Model::RuleSet>{e.parseRuleset()};
@@ -89,7 +90,9 @@ rule R1 w 10 {
     }
     else
     {
-      ssynth::Model::Rendering::ObjRenderer obj{10, 10, true, false};
+      // groupByColor=true: group names carry the hex color (box#a1b2c3),
+      // which the Python side turns into an MTL file / preview colors.
+      ssynth::Model::Rendering::ObjRenderer obj{10, 10, true, true};
       ssynth::Model::Builder b(&obj, ruleset.get(), true);
       b.build();
 
@@ -97,8 +100,33 @@ rule R1 w 10 {
     }
     ts.flush();
   }
+  catch (ssynth::Parser::ParseError& e)
+  {
+    // Position is a char index into the (preprocessed) input; convert to
+    // a 1-based line number for the error message. pos < 0 (End symbol)
+    // means the error is at end-of-input: report no line suffix.
+    int pos = e.getPosition();
+    if (pos >= 0)
+    {
+      int line = 1;
+      int limit = qMin(pos, preprocessed.length());
+      for (int i = 0; i < limit; i++)
+      {
+        if (preprocessed.at(i) == '\n')
+          line++;
+      }
+      fprintf(stderr, "%s (line %d)\n", e.what(), line);
+    }
+    else
+    {
+      fprintf(stderr, "%s (end of input)\n", e.what());
+    }
+    return 1;
+  }
   catch (std::exception& e)
   {
     fprintf(stderr, "%s\n", e.what());
+    return 1;
   }
+  return 0;
 }
diff --git a/src/ssynth/Exception.h b/src/ssynth/Exception.h
